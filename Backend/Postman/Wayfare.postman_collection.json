{
  "info": {
    "name": "Wayfare",
    "description": "Every route of the Wayfare backend (http://localhost:4000), folder by folder.\n\nBefore you start: the system runs (docker compose up -d --build) and the database has its starting data.\n\nLogin as user and Login as admin save the token in the collection's {{token}}, and every request uses it (Authorization > Bearer Token on the collection). So the order matters: the User folder runs after Login as user, the Admin folder after Login as admin. Run collection runs everything in that order.\n\nAccounts: admin@wayfare.com / Atlas-Harbor-7319, daniel@wayfare.com / 1234.\n\nAdd a vacation needs an image: under Body > form-data > image, choose any picture (for example Backend/src/assets/images/rome.jpg).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:4000/api/register",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "4000",
              "path": [
                "api",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Dana\",\n  \"lastName\": \"Mor\",\n  \"email\": \"dana.mor@wayfare.com\",\n  \"password\": \"1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "201 and a token. A second run answers 409 Email already taken."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const token = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with a wrong password",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:4000/api/login",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "4000",
              "path": [
                "api",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"daniel@wayfare.com\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "401 Incorrect email or password."
          }
        },
        {
          "name": "Login as user",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:4000/api/login",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "4000",
              "path": [
                "api",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"daniel@wayfare.com\",\n  \"password\": \"1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const token = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", token);"
                ]
              }
            }
          ]
        }
      ]
    },
